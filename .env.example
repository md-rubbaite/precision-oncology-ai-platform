# Copy to .env and replace every key with a long random value (at least 24 characters), for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Roles: viewer (model card, cohort), analyst (also analyse files), admin (also reload model, audit trail).
ONCOAI_API_KEYS=viewer:CHANGE_ME_viewer_key_000000,analyst:CHANGE_ME_analyst_key_00000,admin:CHANGE_ME_admin_key_0000000
# Trained model (oncoai train --out models/model.json). Leave unset to serve the synthetic demo model.
# ONCOAI_MODEL=/models/model.json
# Optional file for the console's Example button (must be de-identified).
# ONCOAI_EXAMPLE_MAF=/models/example.maf
